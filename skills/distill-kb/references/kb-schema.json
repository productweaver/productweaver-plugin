{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productweaver.com/schemas/odi-kb/v1",
  "title": "ODI knowledge base",
  "description": "One YAML file holding an Outcome-Driven Innovation study built from interview transcripts. Made with Product Weaver · productweaver.com. Extra fields are allowed so older and derived layers keep loading; the fields below are the contract.",
  "type": "object",
  "required": [
    "meta",
    "interviews",
    "job_map",
    "desired_outcomes"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "project"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "type": "string"
        },
        "interviewer": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "interview_count": {
          "type": "integer",
          "minimum": 0
        },
        "date_range": {
          "type": "string"
        },
        "caveat": {
          "type": "string"
        },
        "generated_with": {
          "type": "string"
        },
        "tool_version": {
          "type": "string",
          "description": "Computed. Version of kb_tool.py that last wrote the file."
        },
        "style": {
          "type": "object",
          "description": "Optional writing rules for this study. Each key overrides the script's default.",
          "properties": {
            "limits": {
              "type": "object",
              "description": "Maximum words per kind of statement: executor, job, step, outcome, feeling, rationale.",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "banned": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tokens a statement may not contain."
            },
            "idioms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Phrases with and/or that are one idea, such as bread and butter."
            },
            "acronyms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Abbreviations every reviewer in this market knows."
            }
          }
        }
      }
    },
    "market_core_job": {
      "type": "object",
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "job_executor": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "approved"
          ]
        },
        "history": {
          "$ref": "#/$defs/history"
        }
      }
    },
    "clusters": {
      "type": "object",
      "description": "Segments, keyed by a short code.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            }
          }
        }
      }
    },
    "interviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "file",
          "job_executor",
          "core_functional_job"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/interview_id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "date": {
            "type": "string"
          },
          "added": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "cluster": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "job_executor": {
            "$ref": "#/$defs/own_statement"
          },
          "core_functional_job": {
            "$ref": "#/$defs/own_statement"
          },
          "related_jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/own_statement"
            }
          },
          "emotional_jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/own_statement"
            }
          },
          "social_jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/own_statement"
            }
          },
          "analyst_note": {
            "type": "string"
          }
        }
      }
    },
    "job_map": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "core_job": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/stage"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "n",
              "stage",
              "statement"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "stage": {
                "$ref": "#/$defs/stage"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "covers": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "interviews": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interview_id"
                }
              },
              "coverage": {
                "type": "integer",
                "minimum": 0
              },
              "history": {
                "$ref": "#/$defs/history"
              }
            }
          }
        }
      }
    },
    "desired_outcomes": {
      "type": "object",
      "required": [
        "outcomes"
      ],
      "properties": {
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "step",
              "statement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$"
              },
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "statement": {
                "type": "string",
                "pattern": "^(Minimize|Maximize|Increase|Reduce) "
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "interviews": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interview_id"
                }
              },
              "interview_count": {
                "type": "integer",
                "minimum": 0
              },
              "quote_count": {
                "type": "integer",
                "minimum": 0
              },
              "added": {
                "type": "string"
              },
              "merged_into": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$"
              },
              "history": {
                "$ref": "#/$defs/history"
              }
            }
          }
        }
      }
    },
    "proposed_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "proposal",
          "rationale",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "new_step",
              "reword_step",
              "reword_outcome",
              "reword_core_job",
              "merge_outcomes",
              "move_outcome",
              "new_segment",
              "other"
            ]
          },
          "target": {
            "type": [
              "string",
              "integer"
            ]
          },
          "stage": {
            "$ref": "#/$defs/stage"
          },
          "merge": {
            "type": "string"
          },
          "to_step": {
            "type": "integer"
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "raised": {
            "type": "string"
          },
          "decided": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "action"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "init",
              "merge",
              "decide",
              "rebuild",
              "edit",
              "migrate"
            ]
          },
          "ts": {
            "type": "string",
            "description": "When the script wrote this entry, ISO 8601 with timezone. Hand-written entries may leave it out."
          },
          "run_id": {
            "type": "string",
            "description": "The run that wrote this entry. The same value is on its line in logs/kb_tool.jsonl, so the entry can be traced to its log line and backup."
          },
          "patch": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "added_interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            },
            "description": "merge: IDs of the interviews added."
          },
          "new_outcomes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "merge: IDs of the outcomes added."
          },
          "step_quotes": {
            "type": "integer",
            "minimum": 0,
            "description": "merge: quotes added to steps."
          },
          "outcome_quotes": {
            "type": "integer",
            "minimum": 0,
            "description": "merge: quotes added to outcomes."
          },
          "proposals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "merge: IDs of the proposals filed."
          },
          "bootstrap": {
            "type": "boolean",
            "description": "merge: true when this merge created the core job and job map."
          },
          "proposal": {
            "type": "string",
            "description": "decide: the proposal decided on."
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "description": "decide: the outcome."
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      }
    },
    "survey": {
      "$ref": "#/$defs/derived"
    },
    "simulation": {
      "$ref": "#/$defs/derived"
    },
    "value_themes": {
      "$ref": "#/$defs/derived"
    },
    "use_cases": {
      "$ref": "#/$defs/derived"
    }
  },
  "$defs": {
    "interview_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "define",
        "locate",
        "prepare",
        "confirm",
        "execute",
        "monitor",
        "modify",
        "conclude"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "transcript",
        "quoted_in_notes",
        "interviewer_notes"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "interview",
        "source",
        "quote"
      ],
      "properties": {
        "interview": {
          "$ref": "#/$defs/interview_id"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "own_evidence": {
      "type": "object",
      "required": [
        "source",
        "quote"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "own_statement": {
      "type": "object",
      "required": [
        "statement",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/own_evidence"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "was": {
            "type": "string"
          },
          "was_id": {
            "type": "string"
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "properties": {
        "stale": {
          "type": "boolean"
        },
        "stale_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Where a batch came from: which assistant and model extracted it, when that started, which interviews were read, and notes for later readers. merge: copied from the patch, with transcripts_read as KB interview IDs.",
      "properties": {
        "assistant": {
          "type": "string",
          "description": "The AI assistant that wrote the patch, such as claude-code, codex, cursor, copilot or gemini-cli."
        },
        "model": {
          "type": "string",
          "description": "The model behind it, such as claude-opus-5-5."
        },
        "started": {
          "type": "string",
          "description": "When the assistant started reading transcripts for this batch, ISO 8601 with timezone."
        },
        "transcripts_read": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interview_id"
          },
          "description": "The interviews read for this batch. Never file names: they carry the interviewee's name."
        },
        "notes": {
          "type": "string",
          "description": "Anything a later reader should know about how this batch was extracted."
        }
      }
    }
  }
}

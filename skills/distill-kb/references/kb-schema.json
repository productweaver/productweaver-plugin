{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productweaver.com/schemas/odi-kb/v2",
  "title": "ODI knowledge base",
  "description": "One YAML file holding an Outcome-Driven Innovation study built from interview transcripts. Made with Product Weaver · productweaver.com. Extra fields are allowed so older and derived layers keep loading; the fields below are the contract.",
  "type": "object",
  "required": [
    "meta",
    "core_jobs",
    "interviews",
    "job_map",
    "desired_outcomes"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "project"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "type": "string"
        },
        "interviewer": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "interview_count": {
          "type": "integer",
          "minimum": 0
        },
        "date_range": {
          "type": "string"
        },
        "caveat": {
          "type": "string"
        },
        "generated_with": {
          "type": "string"
        },
        "tool_version": {
          "type": "string",
          "description": "Computed. Version of kb_tool.py that last wrote the file."
        },
        "style": {
          "type": "object",
          "description": "Optional writing rules for this study. Each key overrides the script's default.",
          "properties": {
            "limits": {
              "type": "object",
              "description": "Maximum words per kind of statement: executor, job, step, outcome, feeling, rationale.",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "banned": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tokens a statement may not contain."
            },
            "idioms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Phrases with and/or that are one idea, such as bread and butter."
            },
            "acronyms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Abbreviations every reviewer in this market knows."
            }
          }
        }
      }
    },
    "core_jobs": {
      "type": "array",
      "description": "The core functional jobs this study found, abstracted from each interview's own core job.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/job_id"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "job_executor": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved"
            ]
          },
          "history": {
            "$ref": "#/$defs/history"
          },
          "interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            },
            "description": "Computed. Interviews whose own core job rolls up to this one."
          },
          "related_interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            },
            "description": "Computed. Interviews with a related job that rolls up to this one."
          },
          "coverage": {
            "type": "integer",
            "minimum": 0,
            "description": "Computed. Interviews quoted on this job's steps or outcomes."
          }
        }
      }
    },
    "clusters": {
      "type": "object",
      "description": "Segments, keyed by a short code.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            }
          }
        }
      }
    },
    "interviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "file",
          "job_executor",
          "core_functional_job"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/interview_id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "date": {
            "type": "string"
          },
          "added": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "cluster": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "job_executor": {
            "$ref": "#/$defs/own_statement"
          },
          "core_functional_job": {
            "$ref": "#/$defs/own_job"
          },
          "related_jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/own_job"
            }
          },
          "emotional_jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/own_statement"
            }
          },
          "social_jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/own_statement"
            }
          },
          "analyst_note": {
            "type": "string"
          }
        }
      }
    },
    "job_map": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/stage"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "job",
              "n",
              "stage",
              "statement"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/step_id",
                "description": "Computed. Job letter and number, such as A.6."
              },
              "job": {
                "$ref": "#/$defs/job_id"
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "description": "Step number inside its core job. Stable once published."
              },
              "stage": {
                "$ref": "#/$defs/stage"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "covers": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "interviews": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interview_id"
                }
              },
              "coverage": {
                "type": "integer",
                "minimum": 0
              },
              "history": {
                "$ref": "#/$defs/history"
              }
            }
          }
        }
      }
    },
    "desired_outcomes": {
      "type": "object",
      "required": [
        "outcomes"
      ],
      "properties": {
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "step",
              "statement"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/outcome_id"
              },
              "step": {
                "$ref": "#/$defs/step_id"
              },
              "statement": {
                "type": "string",
                "pattern": "^(Minimize|Maximize|Increase|Reduce) "
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "interviews": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interview_id"
                }
              },
              "interview_count": {
                "type": "integer",
                "minimum": 0
              },
              "quote_count": {
                "type": "integer",
                "minimum": 0
              },
              "added": {
                "type": "string"
              },
              "merged_into": {
                "$ref": "#/$defs/outcome_id"
              },
              "history": {
                "$ref": "#/$defs/history"
              }
            }
          }
        }
      }
    },
    "proposed_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "proposal",
          "rationale",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "new_step",
              "reword_step",
              "reword_outcome",
              "reword_core_job",
              "merge_outcomes",
              "move_outcome",
              "new_segment",
              "new_core_job",
              "confirm_core_job",
              "move_step",
              "relink_interview",
              "other"
            ]
          },
          "target": {
            "type": "string",
            "description": "Step ID, outcome ID, core job ID, segment key or interview ID, by type."
          },
          "stage": {
            "$ref": "#/$defs/stage"
          },
          "merge": {
            "$ref": "#/$defs/outcome_id"
          },
          "to_step": {
            "$ref": "#/$defs/step_id"
          },
          "to_job": {
            "$ref": "#/$defs/job_id"
          },
          "job": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{1,2}$",
            "description": "new_step: the core job the step joins. relink_interview: the core job to link to, or null."
          },
          "job_executor": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "description": "new_core_job: the new job's first steps, numbered from 1 when it is approved.",
            "items": {
              "type": "object",
              "required": [
                "stage",
                "statement"
              ],
              "properties": {
                "stage": {
                  "$ref": "#/$defs/stage"
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "covers": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              }
            }
          },
          "interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            },
            "description": "new_core_job: interviews whose own core job is linked to the new job when it is approved."
          },
          "related_job": {
            "type": "string",
            "description": "relink_interview: the related job to link, by its statement. Without it, the main link changes."
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "raised": {
            "type": "string"
          },
          "decided": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "action"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "init",
              "merge",
              "decide",
              "rebuild",
              "edit",
              "migrate"
            ]
          },
          "ts": {
            "type": "string",
            "description": "When the script wrote this entry, ISO 8601 with timezone. Hand-written entries may leave it out."
          },
          "run_id": {
            "type": "string",
            "description": "The run that wrote this entry. The same value is on its line in logs/kb_tool.jsonl, so the entry can be traced to its log line and backup."
          },
          "patch": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "added_interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            },
            "description": "merge: IDs of the interviews added."
          },
          "new_outcomes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "merge: IDs of the outcomes added."
          },
          "step_quotes": {
            "type": "integer",
            "minimum": 0,
            "description": "merge: quotes added to steps."
          },
          "outcome_quotes": {
            "type": "integer",
            "minimum": 0,
            "description": "merge: quotes added to outcomes."
          },
          "proposals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "merge: IDs of the proposals filed."
          },
          "bootstrap": {
            "type": "boolean",
            "description": "merge: true when this merge created the core jobs and job map."
          },
          "proposal": {
            "type": "string",
            "description": "decide: the proposal decided on."
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "description": "decide: the outcome."
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      }
    },
    "survey": {
      "$ref": "#/$defs/derived"
    },
    "simulation": {
      "$ref": "#/$defs/derived"
    },
    "value_themes": {
      "$ref": "#/$defs/derived"
    },
    "use_cases": {
      "$ref": "#/$defs/derived"
    }
  },
  "$defs": {
    "interview_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "define",
        "locate",
        "prepare",
        "confirm",
        "execute",
        "monitor",
        "modify",
        "conclude"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "transcript",
        "quoted_in_notes",
        "interviewer_notes"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "interview",
        "source",
        "quote"
      ],
      "properties": {
        "interview": {
          "$ref": "#/$defs/interview_id"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "own_evidence": {
      "type": "object",
      "required": [
        "source",
        "quote"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "own_statement": {
      "type": "object",
      "required": [
        "statement",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/own_evidence"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "was": {
            "type": "string"
          },
          "was_id": {
            "type": "string"
          },
          "was_job": {
            "type": [
              "string",
              "null"
            ],
            "description": "The core job an interview's job statement was linked to before; null when it had none."
          },
          "was_reason": {
            "type": "string",
            "description": "The unlinked_reason an interview's core job had before it was linked."
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "properties": {
        "stale": {
          "type": "boolean"
        },
        "stale_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Where a batch came from: which assistant and model extracted it, when that started, which interviews were read, and notes for later readers. merge: copied from the patch, with transcripts_read as KB interview IDs.",
      "properties": {
        "assistant": {
          "type": "string",
          "description": "The AI assistant that wrote the patch, such as claude-code, codex, cursor, copilot or gemini-cli."
        },
        "model": {
          "type": "string",
          "description": "The model behind it, such as claude-opus-5-5."
        },
        "started": {
          "type": "string",
          "description": "When the assistant started reading transcripts for this batch, ISO 8601 with timezone."
        },
        "transcripts_read": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interview_id"
          },
          "description": "The interviews read for this batch. Never file names: they carry the interviewee's name."
        },
        "notes": {
          "type": "string",
          "description": "Anything a later reader should know about how this batch was extracted."
        }
      }
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}$",
      "description": "A core job's ID: A, B, C… then AA."
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}\\.[0-9]+$",
      "description": "A step's ID: its core job's letter and its number inside that job, such as A.6."
    },
    "outcome_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}\\.[0-9]+\\.[0-9]+$",
      "description": "An outcome's ID: its step's ID and its number under that step, such as A.6.3."
    },
    "own_job": {
      "type": "object",
      "description": "An interview's own core functional job or related job, with an optional link to a core job.",
      "required": [
        "statement",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "job": {
          "$ref": "#/$defs/job_id"
        },
        "unlinked_reason": {
          "type": "string",
          "description": "Core functional job only: why it rolls up to none of the study's core jobs. Leave out when job is set."
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/own_evidence"
          }
        },
        "history": {
          "$ref": "#/$defs/history"
        }
      }
    }
  }
}

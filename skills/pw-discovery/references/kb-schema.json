{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productweaver.com/schemas/pw-kb/v2",
  "title": "ODI knowledge base",
  "description": "One YAML file holding an Outcome-Driven Innovation study built from interview transcripts. Made with Product Weaver · productweaver.com. Extra fields are allowed so older and derived layers keep loading; the fields below are the contract.",
  "type": "object",
  "required": [
    "meta",
    "core_jobs",
    "interviews",
    "job_map",
    "desired_outcomes"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "project"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "type": "string"
        },
        "interviewer": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "interview_count": {
          "type": "integer",
          "minimum": 0
        },
        "date_range": {
          "type": "string"
        },
        "caveat": {
          "type": "string"
        },
        "generated_with": {
          "type": "string"
        },
        "tool_version": {
          "type": "string",
          "description": "Computed. Version of kb_tool.py that last wrote the file."
        },
        "style": {
          "type": "object",
          "description": "Optional writing rules for this study. Each key overrides the script's default.",
          "properties": {
            "limits": {
              "type": "object",
              "description": "Maximum words per kind of statement: executor, job, step, outcome, feeling, rationale, solution, group.",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "banned": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tokens a statement may not contain."
            },
            "idioms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Phrases with and/or that are one idea, such as bread and butter."
            },
            "acronyms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Abbreviations every reviewer in this market knows."
            }
          }
        }
      }
    },
    "core_jobs": {
      "type": "array",
      "description": "The core functional jobs this study found, abstracted from each interview's own core job.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/job_id"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "job_executor": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved"
            ]
          },
          "history": {
            "$ref": "#/$defs/history"
          },
          "interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            },
            "description": "Computed. Interviews whose own core job rolls up to this one."
          },
          "related_interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            },
            "description": "Computed. Interviews with a related job that rolls up to this one."
          },
          "coverage": {
            "type": "integer",
            "minimum": 0,
            "description": "Computed. Interviews quoted on this job's steps or outcomes."
          }
        }
      }
    },
    "clusters": {
      "type": "object",
      "description": "Segments, keyed by a short code.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            }
          }
        }
      }
    },
    "interviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "file",
          "job_executor",
          "core_functional_job"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/interview_id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "date": {
            "type": "string"
          },
          "added": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "cluster": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "job_executor": {
            "$ref": "#/$defs/own_statement"
          },
          "core_functional_job": {
            "$ref": "#/$defs/own_job"
          },
          "related_jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/own_job"
            }
          },
          "emotional_jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/own_statement"
            }
          },
          "social_jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/own_statement"
            }
          },
          "analyst_note": {
            "type": "string"
          }
        }
      }
    },
    "job_map": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/stage"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "job",
              "n",
              "stage",
              "statement"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/step_id",
                "description": "Computed. Job letter and number, such as A.6."
              },
              "job": {
                "$ref": "#/$defs/job_id"
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "description": "Step number inside its core job. Stable once published."
              },
              "stage": {
                "$ref": "#/$defs/stage"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "covers": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "interviews": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interview_id"
                }
              },
              "coverage": {
                "type": "integer",
                "minimum": 0
              },
              "history": {
                "$ref": "#/$defs/history"
              }
            }
          }
        }
      }
    },
    "desired_outcomes": {
      "type": "object",
      "required": [
        "outcomes"
      ],
      "properties": {
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "step",
              "statement"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/outcome_id"
              },
              "step": {
                "$ref": "#/$defs/step_id"
              },
              "statement": {
                "type": "string",
                "pattern": "^(Minimize|Maximize|Increase|Reduce) "
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "interviews": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interview_id"
                }
              },
              "interview_count": {
                "type": "integer",
                "minimum": 0
              },
              "quote_count": {
                "type": "integer",
                "minimum": 0
              },
              "added": {
                "type": "string"
              },
              "merged_into": {
                "$ref": "#/$defs/outcome_id"
              },
              "history": {
                "$ref": "#/$defs/history"
              }
            }
          }
        }
      }
    },
    "current_solutions": {
      "type": "object",
      "description": "What people use today to get a step done, and what they stopped using. Optional: the first merge that adds a solution creates it.",
      "properties": {
        "groups": {
          "type": "object",
          "description": "Groups of solutions that compete for the same work, keyed by a short lowercase key.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "name",
              "why"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "description": "Why these solutions belong together, in one sentence."
              },
              "added": {
                "type": "string"
              },
              "history": {
                "$ref": "#/$defs/history"
              },
              "solutions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/solution_id"
                },
                "description": "Computed: the live solutions in this group."
              }
            }
          }
        },
        "solutions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind",
              "group",
              "uses"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/solution_id"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "$ref": "#/$defs/solution_kind"
              },
              "group": {
                "$ref": "#/$defs/group_key"
              },
              "added": {
                "type": "string"
              },
              "uses": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/solution_use"
                }
              },
              "interviews": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interview_id"
                },
                "description": "Computed: who is quoted on a current use."
              },
              "stopped_by": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interview_id"
                },
                "description": "Computed: who is quoted only on stopped uses."
              },
              "quote_count": {
                "type": "integer",
                "minimum": 0,
                "description": "Computed: how many different quotes mention it."
              },
              "merged_into": {
                "$ref": "#/$defs/solution_id"
              },
              "history": {
                "$ref": "#/$defs/history"
              }
            }
          }
        }
      }
    },
    "proposed_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "proposal",
          "rationale",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "new_step",
              "reword_step",
              "reword_outcome",
              "reword_core_job",
              "merge_outcomes",
              "move_outcome",
              "new_segment",
              "new_core_job",
              "confirm_core_job",
              "move_step",
              "relink_interview",
              "merge_solutions",
              "move_solution",
              "reword_solution",
              "reword_solution_group",
              "other"
            ]
          },
          "target": {
            "type": "string",
            "description": "Step ID for reword_step and move_step; outcome ID for reword_outcome, merge_outcomes and move_outcome; core job ID for reword_core_job and confirm_core_job; segment key for new_segment; interview ID for relink_interview; solution ID for merge_solutions, move_solution and reword_solution; group key for reword_solution_group."
          },
          "stage": {
            "$ref": "#/$defs/stage"
          },
          "merge": {
            "type": "string",
            "pattern": "^([A-Z]{1,2}\\.[0-9]+\\.[0-9]+|S[0-9]+)$",
            "description": "merge_outcomes: the outcome folded into target. merge_solutions: the solution folded into target."
          },
          "to_step": {
            "$ref": "#/$defs/step_id"
          },
          "to_job": {
            "$ref": "#/$defs/job_id"
          },
          "to_group": {
            "$ref": "#/$defs/group_key",
            "description": "move_solution: the group the solution moves to."
          },
          "kind": {
            "$ref": "#/$defs/solution_kind",
            "description": "reword_solution: the solution's corrected kind."
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "reword_solution_group: the group's new reason, one sentence."
          },
          "job": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{1,2}$",
            "description": "new_step: the core job the step joins. relink_interview: the core job to link to, or null."
          },
          "job_executor": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "description": "new_core_job: the new job's first steps, numbered from 1 when it is approved.",
            "items": {
              "type": "object",
              "required": [
                "stage",
                "statement"
              ],
              "properties": {
                "stage": {
                  "$ref": "#/$defs/stage"
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "covers": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              }
            }
          },
          "interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            },
            "description": "new_core_job: interviews whose own core job is linked to the new job when it is approved."
          },
          "related_job": {
            "type": "string",
            "description": "relink_interview: the related job to link, by its statement. Without it, the main link changes."
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "raised": {
            "type": "string"
          },
          "decided": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "action"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "init",
              "merge",
              "decide",
              "rebuild",
              "edit",
              "migrate"
            ]
          },
          "ts": {
            "type": "string",
            "description": "When the script wrote this entry, ISO 8601 with timezone. Hand-written entries may leave it out."
          },
          "run_id": {
            "type": "string",
            "description": "The run that wrote this entry. The same value is on its line in logs/kb_tool.jsonl, so the entry can be traced to its log line and backup."
          },
          "patch": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "added_interviews": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interview_id"
            },
            "description": "merge: IDs of the interviews added."
          },
          "new_outcomes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "merge: IDs of the outcomes added."
          },
          "step_quotes": {
            "type": "integer",
            "minimum": 0,
            "description": "merge: quotes added to steps."
          },
          "outcome_quotes": {
            "type": "integer",
            "minimum": 0,
            "description": "merge: quotes added to outcomes."
          },
          "new_solutions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/solution_id"
            },
            "description": "merge: IDs of the solutions added."
          },
          "new_solution_groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "merge: keys of the solution groups added."
          },
          "solution_quotes": {
            "type": "integer",
            "minimum": 0,
            "description": "merge: quotes added to solutions already in the KB."
          },
          "proposals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "merge: IDs of the proposals filed."
          },
          "bootstrap": {
            "type": "boolean",
            "description": "merge: true when this merge created the core jobs and job map."
          },
          "proposal": {
            "type": "string",
            "description": "decide: the proposal decided on."
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "description": "decide: the outcome."
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "layer": {
            "type": "string",
            "description": "rebuild: the derived layer that was rebuilt, such as value_themes."
          },
          "job": {
            "type": "string",
            "description": "rebuild: the core job whose value themes were written."
          },
          "themes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "rebuild: IDs of that core job's value themes after the run."
          }
        }
      }
    },
    "survey": {
      "$ref": "#/$defs/derived"
    },
    "simulation": {
      "$ref": "#/$defs/derived"
    },
    "value_themes": {
      "type": "object",
      "description": "Value themes: a few needs in the customer's words that group the desired outcomes of a core job, to sort ideas into. Written by `kb_tool.py themes`.",
      "properties": {
        "stale": {
          "type": "boolean"
        },
        "stale_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value_theme"
          }
        },
        "unassigned": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Computed. Live outcomes that sit in no theme, for the core jobs that have themes."
        }
      }
    },
    "overview": {
      "type": "object",
      "description": "The study told as a short story for someone new to the method, one entry per core job, with what to do next. Written by `kb_tool.py overview`. The map counts unmet needs and ranks themes itself.",
      "properties": {
        "stale": {
          "type": "boolean"
        },
        "stale_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overview_job"
          }
        }
      }
    },
    "use_cases": {
      "$ref": "#/$defs/derived"
    }
  },
  "$defs": {
    "interview_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "define",
        "locate",
        "prepare",
        "confirm",
        "execute",
        "monitor",
        "modify",
        "conclude"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "transcript",
        "quoted_in_notes",
        "interviewer_notes"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "interview",
        "source",
        "quote"
      ],
      "properties": {
        "interview": {
          "$ref": "#/$defs/interview_id"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "own_evidence": {
      "type": "object",
      "required": [
        "source",
        "quote"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "own_statement": {
      "type": "object",
      "required": [
        "statement",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/own_evidence"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "was": {
            "type": "string"
          },
          "was_id": {
            "type": "string"
          },
          "was_job": {
            "type": [
              "string",
              "null"
            ],
            "description": "The core job an interview's job statement was linked to before; null when it had none."
          },
          "was_reason": {
            "type": "string",
            "description": "The unlinked_reason an interview's core job had before it was linked."
          },
          "was_group": {
            "type": "string",
            "description": "The group a solution was in before it moved."
          },
          "was_kind": {
            "type": "string",
            "description": "A solution's kind before it was corrected."
          },
          "was_why": {
            "type": "string",
            "description": "A solution group's reason before it was reworded."
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "properties": {
        "stale": {
          "type": "boolean"
        },
        "stale_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Where a batch came from: which assistant and model extracted it, when that started, which interviews were read, and notes for later readers. merge: copied from the patch, with transcripts_read as KB interview IDs.",
      "properties": {
        "assistant": {
          "type": "string",
          "description": "The AI assistant that wrote the patch, such as claude-code, codex, cursor, copilot or gemini-cli."
        },
        "model": {
          "type": "string",
          "description": "The model behind it, such as claude-opus-5-5."
        },
        "started": {
          "type": "string",
          "description": "When the assistant started reading transcripts for this batch, ISO 8601 with timezone."
        },
        "transcripts_read": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interview_id"
          },
          "description": "The interviews read for this batch. Never file names: they carry the interviewee's name."
        },
        "notes": {
          "type": "string",
          "description": "Anything a later reader should know about how this batch was extracted."
        }
      }
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}$",
      "description": "A core job's ID: A, B, C… then AA."
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}\\.[0-9]+$",
      "description": "A step's ID: its core job's letter and its number inside that job, such as A.6."
    },
    "outcome_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}\\.[0-9]+\\.[0-9]+$",
      "description": "An outcome's ID: its step's ID and its number under that step, such as A.6.3."
    },
    "own_job": {
      "type": "object",
      "description": "An interview's own core functional job or related job, with an optional link to a core job.",
      "required": [
        "statement",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "job": {
          "$ref": "#/$defs/job_id"
        },
        "unlinked_reason": {
          "type": "string",
          "description": "Core functional job only: why it rolls up to none of the study's core jobs. Leave out when job is set."
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/own_evidence"
          }
        },
        "history": {
          "$ref": "#/$defs/history"
        }
      }
    },
    "solution_id": {
      "type": "string",
      "pattern": "^S[0-9]+$",
      "description": "A solution's ID, such as S3. Study-wide, never reused."
    },
    "group_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "A solution group's short lowercase key, such as send-orders."
    },
    "solution_kind": {
      "type": "string",
      "enum": [
        "product",
        "everyday_tool",
        "people",
        "own_method"
      ],
      "description": "product: a product, app or service they sign up to. everyday_tool: a general tool bent to the job, such as a spreadsheet, paper or a phone. people: a person or firm who does it for them. own_method: a habit, rule of thumb or doing it in their head."
    },
    "solution_status": {
      "type": "string",
      "enum": [
        "current",
        "stopped"
      ],
      "description": "current: they use it now. stopped: they used it for this step and stopped; the quote usually says why."
    },
    "solution_use": {
      "type": "object",
      "required": [
        "step",
        "status",
        "evidence"
      ],
      "description": "One step a solution is used for, with the quotes that show it. One per step and status.",
      "properties": {
        "step": {
          "$ref": "#/$defs/step_id"
        },
        "status": {
          "$ref": "#/$defs/solution_status"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "value_theme": {
      "type": "object",
      "description": "One value theme. A theme with no id was written by hand before `kb_tool.py themes` existed; the script keeps it and does not check it.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}\\.T[0-9]+$"
        },
        "job": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}$"
        },
        "label": {
          "type": "string",
          "description": "Verb-first name of at most 6 words."
        },
        "need": {
          "type": "string",
          "description": "The need in the customer's voice: one sentence that starts with 'Help me', at most 25 words."
        },
        "why": {
          "type": "string",
          "description": "What binds the outcomes, in one sentence of at most 30 words."
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of the outcomes the theme groups. An outcome may sit in two themes."
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/highlight"
          }
        },
        "added": {
          "type": "string"
        },
        "interviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interview_id"
          }
        },
        "interview_count": {
          "type": "integer",
          "minimum": 0
        },
        "quote_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "highlight": {
      "type": "object",
      "description": "A quote picked to show a theme's pain, struggle or desire. It is a copy of a quote on one of the theme's outcomes or on a solution used at their steps.",
      "required": [
        "kind",
        "interview",
        "source",
        "quote"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "pain",
            "struggle",
            "desire"
          ]
        },
        "interview": {
          "$ref": "#/$defs/interview_id"
        },
        "source": {
          "type": "string",
          "enum": [
            "transcript",
            "quoted_in_notes",
            "interviewer_notes"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "overview_quote": {
      "type": "object",
      "description": "A quote the KB already holds for the core job.",
      "required": [
        "interview",
        "quote"
      ],
      "properties": {
        "interview": {
          "$ref": "#/$defs/interview_id"
        },
        "source": {
          "type": "string",
          "enum": [
            "transcript",
            "quoted_in_notes",
            "interviewer_notes"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "Computed."
        }
      }
    },
    "overview_job": {
      "type": "object",
      "description": "One core job's overview.",
      "required": [
        "job",
        "bottom_line"
      ],
      "properties": {
        "job": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}$"
        },
        "executor": {
          "type": "object",
          "required": [
            "label",
            "text",
            "icon"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "A short name for the people the study is about, such as \"Small-firm bookkeeper\"."
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Who they are and what they do, in one sentence."
            },
            "icon": {
              "type": "string",
              "enum": [
                "person",
                "office",
                "finance",
                "shop",
                "sales",
                "support",
                "manager",
                "developer",
                "designer",
                "driver",
                "warehouse",
                "builder",
                "repair",
                "cook",
                "health",
                "care",
                "teacher",
                "student",
                "farmer",
                "legal",
                "parent"
              ],
              "description": "The icon the map draws for them; person when none fits."
            },
            "others": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Optional. Up to 3 other people who appear in the story but are not its focus."
            }
          },
          "additionalProperties": false,
          "description": "Who the study is about. Optional, because overviews written before it existed have none."
        },
        "bottom_line": {
          "type": "string",
          "minLength": 1,
          "description": "The main finding, in one sentence."
        },
        "why": {
          "type": "string",
          "description": "Why the problem is still there."
        },
        "opening": {
          "type": "string",
          "description": "Where a new solution fits."
        },
        "people": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1,
              "description": "The answer to the step's question, in one sentence."
            },
            "text": {
              "type": "string",
              "description": "Optional. One or two sentences that explain the answer."
            },
            "quote": {
              "$ref": "#/$defs/overview_quote"
            }
          },
          "description": "Who was listened to."
        },
        "today": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1,
              "description": "The answer to the step's question, in one sentence."
            },
            "text": {
              "type": "string",
              "description": "Optional. One or two sentences that explain the answer."
            },
            "quote": {
              "$ref": "#/$defs/overview_quote"
            }
          },
          "description": "How they get the job done today."
        },
        "gaps": {
          "type": "object",
          "description": "Where today's way falls short.",
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "kind"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "pain",
                      "struggle"
                    ]
                  },
                  "solutions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^S[0-9]+$"
                    }
                  },
                  "quote": {
                    "$ref": "#/$defs/overview_quote"
                  }
                }
              }
            }
          }
        },
        "needs": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1,
              "description": "The answer to the step's question, in one sentence."
            },
            "text": {
              "type": "string",
              "description": "Optional. One or two sentences that explain the answer."
            },
            "quote": {
              "$ref": "#/$defs/overview_quote"
            }
          },
          "description": "What they most want to get better. The list is counted by the map."
        },
        "focus": {
          "type": "object",
          "required": [
            "answer"
          ],
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1,
              "description": "The answer to the step's question, in one sentence."
            },
            "text": {
              "type": "string",
              "description": "Optional. One or two sentences that explain the answer."
            },
            "quote": {
              "$ref": "#/$defs/overview_quote"
            }
          },
          "description": "Where a new solution should focus. The themes are ranked by the map."
        },
        "next": {
          "type": "object",
          "description": "What to do next: advice, not findings.",
          "properties": {
            "learn": {
              "type": "object",
              "required": [
                "status",
                "action"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "now",
                    "enough",
                    "ready",
                    "early"
                  ]
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The one thing to do, as an instruction."
                },
                "why": {
                  "type": "string"
                },
                "tip": {
                  "type": "string"
                },
                "test": {
                  "type": "string"
                },
                "later": {
                  "type": "string"
                },
                "who": {
                  "type": "string"
                },
                "unknown": {
                  "type": "string"
                },
                "ask": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Questions for the next conversations."
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Customers' own words to reuse, each part of a quote in the KB."
                }
              }
            },
            "prototype": {
              "type": "object",
              "required": [
                "status",
                "action"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "now",
                    "enough",
                    "ready",
                    "early"
                  ]
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The one thing to do, as an instruction."
                },
                "why": {
                  "type": "string"
                },
                "tip": {
                  "type": "string"
                },
                "test": {
                  "type": "string"
                },
                "later": {
                  "type": "string"
                },
                "who": {
                  "type": "string"
                },
                "unknown": {
                  "type": "string"
                },
                "ask": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Questions for the next conversations."
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Customers' own words to reuse, each part of a quote in the KB."
                }
              }
            },
            "market": {
              "type": "object",
              "required": [
                "status",
                "action"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "now",
                    "enough",
                    "ready",
                    "early"
                  ]
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The one thing to do, as an instruction."
                },
                "why": {
                  "type": "string"
                },
                "tip": {
                  "type": "string"
                },
                "test": {
                  "type": "string"
                },
                "later": {
                  "type": "string"
                },
                "who": {
                  "type": "string"
                },
                "unknown": {
                  "type": "string"
                },
                "ask": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Questions for the next conversations."
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Customers' own words to reuse, each part of a quote in the KB."
                }
              }
            }
          }
        },
        "written": {
          "type": "string",
          "description": "Computed. Date the overview was written."
        }
      }
    }
  }
}

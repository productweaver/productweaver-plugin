{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productweaver.com/schemas/pw-patch/v2",
  "title": "ODI knowledge base patch",
  "description": "One YAML file describing what a batch of interview transcripts adds to an ODI knowledge base. kb_tool.py merge checks a patch against this schema before any other check. Every key is optional, but a patch needs at least one of them. Write every ID in quotes: interviews like \"01\", steps like \"A.6\", outcomes like \"A.6.3\". The prose version is patch-format.md. Made with Product Weaver · productweaver.com",
  "type": "object",
  "properties": {
    "interviews": {
      "type": "array",
      "description": "New interviews only. Each one gets a short key you choose; the merge assigns the real ID.",
      "items": {
        "$ref": "#/$defs/new_interview"
      }
    },
    "bootstrap": {
      "$ref": "#/$defs/bootstrap"
    },
    "step_evidence": {
      "type": "array",
      "description": "Quotes showing someone doing an existing step.",
      "items": {
        "type": "object",
        "required": [
          "step",
          "evidence"
        ],
        "properties": {
          "step": {
            "$ref": "#/$defs/step_ref"
          },
          "evidence": {
            "$ref": "#/$defs/evidence_list"
          }
        }
      }
    },
    "outcome_evidence": {
      "type": "array",
      "description": "Quotes supporting an existing outcome.",
      "items": {
        "type": "object",
        "required": [
          "outcome",
          "evidence"
        ],
        "properties": {
          "outcome": {
            "$ref": "#/$defs/outcome_id"
          },
          "evidence": {
            "$ref": "#/$defs/evidence_list"
          }
        }
      }
    },
    "new_outcomes": {
      "type": "array",
      "description": "Outcomes no existing outcome covers. The statement must start with Minimize, Maximize, Increase or Reduce.",
      "items": {
        "type": "object",
        "required": [
          "step",
          "statement",
          "evidence"
        ],
        "properties": {
          "step": {
            "$ref": "#/$defs/step_ref"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "#/$defs/evidence_list"
          }
        }
      }
    },
    "solution_groups": {
      "type": "array",
      "description": "New groups of solutions that compete for the same work. A new solution or a move_solution proposal in this patch must put a solution in each one.",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "why"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/group_key"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "Why these solutions belong together, in one sentence."
          }
        }
      }
    },
    "new_solutions": {
      "type": "array",
      "description": "Solutions not in the KB yet: what people use today, or stopped using, to get a step done.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "group",
          "uses"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "$ref": "#/$defs/solution_kind"
          },
          "group": {
            "$ref": "#/$defs/group_key"
          },
          "uses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/solution_use"
            }
          }
        }
      }
    },
    "solution_evidence": {
      "type": "array",
      "description": "More quotes for a solution already in the KB, at a step it is used for.",
      "items": {
        "type": "object",
        "required": [
          "solution",
          "step",
          "evidence"
        ],
        "properties": {
          "solution": {
            "$ref": "#/$defs/solution_id"
          },
          "step": {
            "$ref": "#/$defs/step_ref"
          },
          "status": {
            "$ref": "#/$defs/solution_status",
            "description": "current (the default) or stopped."
          },
          "evidence": {
            "$ref": "#/$defs/evidence_list"
          }
        }
      }
    },
    "proposed_changes": {
      "type": "array",
      "description": "Structural changes. Stored as pending for the user to decide.",
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "interview_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A KB interview ID in quotes (\"07\") or a key declared under interviews in this patch (n1)."
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}$",
      "description": "A core job's ID, such as \"A\"."
    },
    "step_ref": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[A-Z]{1,2}\\.[0-9]+$",
      "minimum": 1,
      "description": "A step ID in quotes, such as \"A.6\": the core job's letter, then the step's number in that job. A bare number is read as job A only while the KB has one core job."
    },
    "outcome_id": {
      "type": "string",
      "pattern": "^([A-Z]{1,2}\\.)?[0-9]+\\.[0-9]+$",
      "description": "An outcome ID in quotes, such as \"A.6.3\". Without the job letter it is read as job A only while the KB has one core job."
    },
    "stage": {
      "type": "string",
      "enum": [
        "define",
        "locate",
        "prepare",
        "confirm",
        "execute",
        "monitor",
        "modify",
        "conclude"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "transcript",
        "quoted_in_notes",
        "interviewer_notes"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "interview",
        "source",
        "quote"
      ],
      "properties": {
        "interview": {
          "$ref": "#/$defs/interview_ref"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "own_evidence": {
      "type": "object",
      "description": "Evidence inside an interview's own record. The interview is implied.",
      "required": [
        "source",
        "quote"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "own_statement": {
      "type": "object",
      "required": [
        "statement",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/own_evidence"
          }
        }
      }
    },
    "new_interview": {
      "type": "object",
      "required": [
        "key",
        "name",
        "file",
        "job_executor",
        "core_functional_job"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "cluster": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "job_executor": {
          "$ref": "#/$defs/own_statement"
        },
        "core_functional_job": {
          "$ref": "#/$defs/own_job"
        },
        "related_jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/own_job"
          }
        },
        "emotional_jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/own_statement"
          }
        },
        "social_jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/own_statement"
          }
        },
        "analyst_note": {
          "type": "string"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "description": "Only for a KB that has no core job yet. One entry per core job, IDs A, B, C… in order. The older form, market_core_job with steps, is read as core job A.",
      "properties": {
        "core_jobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement",
              "steps"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/job_id"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "job_executor": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "n",
                    "stage",
                    "statement"
                  ],
                  "properties": {
                    "n": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "stage": {
                      "$ref": "#/$defs/stage"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "covers": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "market_core_job": {
          "type": "object",
          "required": [
            "statement"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "job_executor": {
              "type": "string"
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "n",
              "stage",
              "statement"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "stage": {
                "$ref": "#/$defs/stage"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "covers": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "required": [
        "type",
        "proposal",
        "rationale"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "new_step",
            "reword_step",
            "reword_outcome",
            "reword_core_job",
            "merge_outcomes",
            "move_outcome",
            "new_segment",
            "new_core_job",
            "confirm_core_job",
            "move_step",
            "relink_interview",
            "merge_solutions",
            "move_solution",
            "reword_solution",
            "reword_solution_group",
            "other"
          ]
        },
        "target": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Step ID for reword_step and move_step; outcome ID for reword_outcome, merge_outcomes and move_outcome; core job ID for reword_core_job and confirm_core_job; segment key for new_segment; interview ID for relink_interview; solution ID for merge_solutions, move_solution and reword_solution; group key for reword_solution_group."
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "merge": {
          "type": "string",
          "pattern": "^(([A-Z]{1,2}\\.)?[0-9]+\\.[0-9]+|S[0-9]+)$",
          "description": "merge_outcomes: the outcome folded into target. merge_solutions: the solution folded into target."
        },
        "to_step": {
          "$ref": "#/$defs/step_ref"
        },
        "to_job": {
          "$ref": "#/$defs/job_id"
        },
        "to_group": {
          "$ref": "#/$defs/group_key",
          "description": "move_solution: the group the solution moves to."
        },
        "kind": {
          "$ref": "#/$defs/solution_kind",
          "description": "reword_solution: the solution's corrected kind."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "description": "reword_solution_group: the group's new reason, one sentence."
        },
        "job": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{1,2}$",
          "description": "new_step: the core job the step joins. relink_interview: the core job to link to, or null to remove the link."
        },
        "job_executor": {
          "type": "string",
          "description": "new_core_job: who carries out the new job."
        },
        "steps": {
          "type": "array",
          "description": "new_core_job: the new job's first steps. They are numbered from 1 when it is approved.",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "statement"
            ],
            "properties": {
              "stage": {
                "$ref": "#/$defs/stage"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "covers": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              }
            }
          }
        },
        "interviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interview_ref"
          },
          "description": "new_core_job: interviews whose own core job is linked to the new job when it is approved."
        },
        "related_job": {
          "type": "string",
          "description": "relink_interview: the statement of the related job to link. Leave out to change the main link."
        },
        "covers": {
          "type": "string"
        },
        "proposal": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Where a batch came from: which assistant and model extracted it, when that started, which interviews were read, and notes for later readers. Optional. The merge copies it into the KB's changelog entry, with keys turned into IDs.",
      "properties": {
        "assistant": {
          "type": "string",
          "description": "The AI assistant that wrote the patch, such as claude-code, codex, cursor, copilot or gemini-cli."
        },
        "model": {
          "type": "string",
          "description": "The model behind it, such as claude-opus-5-5."
        },
        "started": {
          "type": "string",
          "description": "When the assistant started reading transcripts for this batch, ISO 8601 with timezone."
        },
        "transcripts_read": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interview_ref"
          },
          "description": "The interviews read for this batch. Never file names: they carry the interviewee's name."
        },
        "notes": {
          "type": "string",
          "description": "Anything a later reader should know about how this batch was extracted."
        }
      }
    },
    "own_job": {
      "type": "object",
      "description": "An interview's own core job or related job. job links it to a core job of the KB or of the bootstrap.",
      "required": [
        "statement",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "job": {
          "$ref": "#/$defs/job_id"
        },
        "unlinked_reason": {
          "type": "string",
          "description": "Core functional job only: why it rolls up to none of the study's core jobs. Leave out when job is set."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/own_evidence"
          }
        }
      }
    },
    "solution_id": {
      "type": "string",
      "pattern": "^S[0-9]+$",
      "description": "A solution's ID, such as S3. Study-wide, never reused."
    },
    "group_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "A solution group's short lowercase key, such as send-orders."
    },
    "solution_kind": {
      "type": "string",
      "enum": [
        "product",
        "everyday_tool",
        "people",
        "own_method"
      ],
      "description": "product: a product, app or service they sign up to. everyday_tool: a general tool bent to the job, such as a spreadsheet, paper or a phone. people: a person or firm who does it for them. own_method: a habit, rule of thumb or doing it in their head."
    },
    "solution_status": {
      "type": "string",
      "enum": [
        "current",
        "stopped"
      ],
      "description": "current: they use it now. stopped: they used it for this step and stopped; the quote usually says why."
    },
    "solution_use": {
      "type": "object",
      "required": [
        "step",
        "evidence"
      ],
      "description": "A step the solution is used for, with the quotes that show it.",
      "properties": {
        "step": {
          "$ref": "#/$defs/step_ref"
        },
        "status": {
          "$ref": "#/$defs/solution_status",
          "description": "current (the default) or stopped."
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    }
  }
}
